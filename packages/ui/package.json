{
  "name": "@sunshade/ui",
  "version": "0.1.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens/index.ts",
      "default": "./src/tokens/index.ts"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "default": "./src/components/index.ts"
    },
    "./fonts": {
      "types": "./src/fonts/index.ts",
      "default": "./src/fonts/index.ts"
    },
    "./styles": {
      "types": "./src/styles/tailwind.config.ts",
      "default": "./src/styles/tailwind.config.ts"
    },
    "./tailwind": {
      "types": "./src/tailwind/index.ts",
      "default": "./src/tailwind/index.ts"
    },
    "./tailwind.preset": "./tailwind.preset.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test:boundaries": "vitest run"
  },
  "dependencies": {
    "@sunshade/supabase": "*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.0"
  },
  "peerDependencies": {
    "nativewind": "*",
    "react": "*",
    "react-native": "*",
    "react-native-web": "*",
    "solito": "*"
  },
  "peerDependenciesMeta": {
    "nativewind": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-web": {
      "optional": true
    },
    "solito": {
      "optional": true
    },
    "@sunshade/supabase": {
      "optional": true
    }
  }
}
