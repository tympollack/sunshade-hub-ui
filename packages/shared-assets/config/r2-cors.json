[
  {
    "AllowedOrigins": [
      "https://*.sunshade.icu",
      "https://sunshade.icu",
      "http://localhost:*",
      "http://127.0.0.1:*"
    ],
    "AllowedMethods": [
      "GET",
      "HEAD"
    ],
    "AllowedHeaders": [
      "Content-Type",
      "Range",
      "Origin",
      "Accept",
      "If-None-Match",
      "If-Modified-Since"
    ],
    "ExposeHeaders": [
      "ETag",
      "Content-Type",
      "Content-Length",
      "Content-Range",
      "Cache-Control",
      "cf-cache-status"
    ],
    "MaxAgeSeconds": 86400
  }
]
