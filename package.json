{
  "name": "solito-blank",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/react": "^18.2.21",
    "eslint": "^8.21.0",
    "turbo": "^2.4.4",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "native": "cd apps/expo && npm run android",
    "web": "cd apps/next && npm run dev",
    "lint": "node scripts/lint-filesize.mjs",
    "lint:filesize": "node scripts/lint-filesize.mjs"
  },
  "packageManager": "yarn@4.7.0",
  "eslintConfig": {
    "extends": "next",
    "settings": {
      "next": {
        "rootDir": "apps/next/"
      }
    },
    "root": true,
    "rules": {
      "max-lines": [
        "warn",
        {
          "max": 400,
          "skipBlankLines": true,
          "skipComments": true
        }
      ],
      "max-lines-per-function": [
        "warn",
        {
          "max": 150,
          "skipBlankLines": true,
          "skipComments": true,
          "IIFEs": true
        }
      ]
    },
    "overrides": [
      {
        "files": [
          "apps/next/app/**/page.tsx"
        ],
        "rules": {
          "max-lines": [
            "error",
            {
              "max": 300,
              "skipBlankLines": true,
              "skipComments": true
            }
          ]
        }
      },
      {
        "files": [
          "apps/next/app/dashboard/views/ProfileView.tsx",
          "apps/next/app/dashboard/DashboardClient.tsx"
        ],
        "rules": {
          "max-lines": "off",
          "max-lines-per-function": "off"
        }
      }
    ]
  },
  "prettier": {
    "semi": false,
    "useTabs": false,
    "tabWidth": 2,
    "singleQuote": true
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2"
  }
}
